# -----------------------------------------------------------------------------
# SmartBasket root environment configuration
# Copy this file to .env and replace placeholders.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (required by packages/db and apps/ai)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartbasket

# -----------------------------------------------------------------------------
# Authentication (JWT + refresh cookie)
# -----------------------------------------------------------------------------
# Access-token signing secret.
JWT_ACCESS_SECRET=replace_with_strong_access_secret
# Refresh-token signing secret (can be same as access secret, but prefer separate).
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
# Password reset token signing secret.
JWT_PASSWORD_RESET_SECRET=replace_with_strong_password_reset_secret
# Refresh cookie name used by auth routes/middleware.
REFRESH_TOKEN_COOKIE_NAME=refreshToken

# Optional compatibility keys (some integrations/docs may expect these names)
JWT_SECRET=replace_with_strong_access_secret
REFRESH_TOKEN_SECRET=replace_with_strong_refresh_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# -----------------------------------------------------------------------------
# App URLs (frontend + email links + client API)
# -----------------------------------------------------------------------------
# Public app URL used in email links (preferred by app code).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side app URL fallback.
APP_URL=http://localhost:3000
# Public API base URL used by client API wrapper (empty defaults to same-origin).
NEXT_PUBLIC_API_URL=http://localhost:3000
# Alias for external tooling that expects this key.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Socket client config (optional)
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_SOCKET_PATH=/socket.io

# -----------------------------------------------------------------------------
# Redis / BullMQ
# -----------------------------------------------------------------------------
# Primary connection string used by workers and queues.
REDIS_URL=redis://127.0.0.1:6379

# Optional decomposed values for infra tooling or container templates.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Email / Resend
# -----------------------------------------------------------------------------
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM_EMAIL=SmartBasket <onboarding@resend.dev>

# Alias keys often used by providers/scripts.
EMAIL_FROM=SmartBasket <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# Storage uploads (R2 / Cloudinary / ImageKit abstraction)
# -----------------------------------------------------------------------------
# Supported values in code: r2 | cloudinary | imagekit
UPLOAD_PROVIDER=r2

# Cloudflare R2 (required if UPLOAD_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Compatibility aliases requested by some deployment guides.
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_URL=

# Cloudinary / ImageKit base URLs (used when provider selected)
CLOUDINARY_BASE_URL=https://res.cloudinary.com
IMAGEKIT_BASE_URL=https://ik.imagekit.io

# -----------------------------------------------------------------------------
# AI / ML service integration
# -----------------------------------------------------------------------------
# Used by apps/web service URL resolver.
AI_SERVICE_URL=http://localhost:8000
# Alias requested by external config templates.
ML_SERVICE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Seed/bootstrap controls
# -----------------------------------------------------------------------------
# Required only if you intentionally run seed in production.
ALLOW_PRODUCTION_SEED=false
# Used in admin seed emails.
ADMIN_LOGIN_URL=http://localhost:3000/login?role=admin
