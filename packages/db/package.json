{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "license": "PROPRIETARY",
  "type": "module",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./queries/*": "./src/queries/*.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.0",
    "i": "^0.3.7",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
